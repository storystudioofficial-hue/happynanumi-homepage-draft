---
// 모든 페이지가 쓰는 뼈대. <head> 순서와 내용은 v20 정적 페이지와 같게 유지한다.
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, abs } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;              // 예: '/', '/blog/' — canonical·og:url에 쓴다
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  jsonLd?: object[];
  home?: boolean;
  current?: 'blog';
  bodyClass?: string;
  noindex?: boolean;
}
const {
  title, description, path,
  ogTitle = title, ogDescription = description, ogType = 'website',
  ogImage = SITE.ogImage, jsonLd = [], home = false, current, bodyClass, noindex = false,
} = Astro.props;
const url = abs(path);
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:type" content={ogType}>
<meta property="og:image" content={ogImage}>
{ogImage === SITE.ogImage && <meta property="og:image:width" content="1200">}
{ogImage === SITE.ogImage && <meta property="og:image:height" content="628">}
<meta property="og:url" content={url}>
<meta property="og:site_name" content={SITE.name}>
<meta property="og:locale" content="ko_KR">
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href={url}>
<meta name="naver-site-verification" content="ae1c1d6ea5302ca29ecfbcc762fa50abbd67d6fb">
<link rel="icon" type="image/png" sizes="48x48" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
{jsonLd.map((d) => <script type="application/ld+json" is:inline set:html={JSON.stringify(d)} />)}
<link rel="preload" href="/fonts/maruburi-bold.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<!-- Pretendard는 화면에 쓰인 글자 범위만 받는 분할판을 쓴다(전체판은 굵기마다 약 780KB). -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-dynamic-subset.min.css">
<slot name="head" />
</head>
<body class={bodyClass}>
<IconSprite />

<a class="skip" href="#main">본문 바로가기</a>
<Header home={home} current={current} />

<main id="main">
<slot />
</main>

<Footer />
<script is:inline>
(function(){
  var root=document.documentElement,btns=document.querySelectorAll('.size button');
  function setSize(v,save){
    if(v==='large'){root.dataset.size='large'}else{delete root.dataset.size}
    btns.forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.size===v))});
    if(save){try{localStorage.setItem('hn-size',v)}catch(e){}}
  }
  var saved=null;
  try{saved=localStorage.getItem('hn-size')}catch(e){}
  if(saved==='large')setSize('large',false);
  btns.forEach(function(b){b.addEventListener('click',function(){setSize(b.dataset.size,true)})});
  var links=[].slice.call(document.querySelectorAll('nav a'));
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(!e.isIntersecting)return;
        links.forEach(function(a){
          if(a.getAttribute('href')==='#'+e.target.id){a.setAttribute('aria-current','true')}else{a.removeAttribute('aria-current')}
        });
      });
    },{rootMargin:'-30% 0px -60% 0px'});
    document.querySelectorAll('main section').forEach(function(t){io.observe(t)});
  }
})();
</script>
<script is:inline>
document.addEventListener('click',function(e){var a=e.target.closest('a[href^="#faq-"]');if(!a)return;var d=document.querySelector(a.getAttribute('href'));if(d&&d.tagName==='DETAILS')d.open=true;});
</script>
</body>
</html>
