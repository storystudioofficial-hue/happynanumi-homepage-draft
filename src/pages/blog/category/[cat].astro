---
import Base from '../../../layouts/Base.astro';
import '../../../styles/blog.css';
import { getPosts, type Post } from '../../../data/blog';
import { CATEGORIES } from '../../../data/categories';
import { SITE, abs } from '../../../data/site';
import PostList from '../../../components/blog/PostList.astro';
import CategoryNav from '../../../components/blog/CategoryNav.astro';

// 글이 있는 분류만 페이지를 만든다.
export async function getStaticPaths() {
  const posts = await getPosts();
  return CATEGORIES
    .map((c) => ({ c, list: posts.filter((p) => p.data.category === c.slug) }))
    .filter(({ list }) => list.length > 0)
    .map(({ c, list }) => ({ params: { cat: c.slug }, props: { category: c, list, posts } }));
}

const { category, list, posts } = Astro.props as {
  category: (typeof CATEGORIES)[number]; list: Post[]; posts: Post[];
};
const path = `/blog/category/${category.slug}/`;
const title = `${category.label} | ${SITE.name} 블로그`;
const description = `${SITE.name} 블로그의 ${category.label} 글 모음. ${category.desc}.`;
// 글이 3편 미만인 분류 페이지는 내용이 얇아 검색에서 뺀다.
const thin = list.length < 3;
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: '블로그', item: abs('/blog/') },
    { '@type': 'ListItem', position: 3, name: category.label, item: abs(path) },
  ],
}];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd} current="blog" bodyClass="blog-page" noindex={thin}>
  <div class="blog-wrap">
    <nav class="crumbs" aria-label="현재 위치"><a href="/">홈</a><span>›</span><a href="/blog/">블로그</a><span>›</span>{category.label}</nav>
    <header class="blog-head">
      <p class="kicker">블로그 분류</p>
      <h1>{category.label}</h1>
      <p class="lead">{category.desc}</p>
    </header>
    <CategoryNav posts={posts} current={category.slug} />
    <PostList posts={list} showCategory={false} />
  </div>
</Base>
