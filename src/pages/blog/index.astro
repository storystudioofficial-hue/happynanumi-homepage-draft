---
import Base from '../../layouts/Base.astro';
import '../../styles/blog.css';
import { getPosts, fmtDate, isoDate } from '../../data/blog';
import { SITE, abs } from '../../data/site';

const posts = await getPosts();
const title = `블로그 | ${SITE.name}`;
// [임시 문구] IRON 확인 전
const description = `광주 광산구 ${SITE.name}가 방문요양과 장기요양 제도를 보호자 입장에서 정리한 글입니다.`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Blog', '@id': abs('/blog/#blog'),
    name: `${SITE.name} 블로그`, url: abs('/blog/'), inLanguage: 'ko-KR',
    publisher: { '@id': abs('/#business') },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: '블로그', item: abs('/blog/') },
    ],
  },
];
---
<Base title={title} description={description} path="/blog/" jsonLd={jsonLd} current="blog" bodyClass="blog-page" noindex={posts.length === 0}>
  <div class="blog-wrap">
    <nav class="crumbs" aria-label="현재 위치"><a href="/">홈</a><span>›</span>블로그</nav>
    <header class="blog-head">
      <p class="kicker">{SITE.kind}</p>
      <h1>블로그</h1>
      <p class="lead">{description}</p>
    </header>
    {posts.length ? (
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <b>{p.data.title}{p.data.draft && <span class="draft-tag">초안</span>}</b>
              <p>{p.data.description}</p>
              <time datetime={isoDate(p.data.pubDate)}>{fmtDate(p.data.pubDate)}</time>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">아직 올라온 글이 없습니다.</p>
    )}
  </div>
</Base>
