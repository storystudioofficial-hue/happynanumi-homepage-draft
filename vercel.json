{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "happynanumi-homepage\\.vercel\\.app" }],
      "destination": "https://happy-nanumi.com/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ]
}
